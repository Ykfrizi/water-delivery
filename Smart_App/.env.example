APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Must match a currency enabled on your Paystack business (GHS for Ghana, NGN for Nigeria).
PAYSTACK_CURRENCY=GHS
# Customer redirect after Paystack checkout (browser). NOT the webhook URL.
PAYSTACK_CALLBACK_URL="${APP_URL}/payment/callback"
# Paystack Dashboard → Webhooks (server-to-server only):
# ${APP_URL}/api/v1/payments/paystack/webhook

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP for password-reset codes.
# Create an App Password at https://myaccount.google.com/apppasswords
# (2-Step Verification must be on). Do not use the normal Gmail password.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yungkingfrizi@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="yungkingfrizi@gmail.com"
MAIL_FROM_NAME="Water Delivery"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
